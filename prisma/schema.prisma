generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model clientes {
  id          Int          @id @default(autoincrement())
  nome        String?
  documento   String?      @unique @db.VarChar(14)
  tipo_pessoa String?      @db.VarChar(2)
  email       String?
  cidade      String?
  profissao   String?
  idade       Int?
  apagado     Boolean      @default(false)
  simulacoes  simulacoes[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model simulacoes {
  id                  Int       @id @default(autoincrement())
  uc                  String    @db.VarChar(30)
  cpf                 String?   @db.VarChar(11)
  data                DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  encargos            Decimal   @db.Decimal(12, 2)
  kwh                 Decimal   @db.Decimal(12, 3)
  valor_kwh           Decimal   @db.Decimal(12, 6)
  desconto_percentual Decimal?  @db.Decimal(5, 2)
  economia_mensal     Decimal?  @db.Decimal(12, 2)
  economia_anual      Decimal?  @db.Decimal(12, 2)
  impostos            Decimal?  @db.Decimal(12, 2)
  cliente_id          Int?
  concessionaria      String?
  apagado             Boolean   @default(false)
  clientes            clientes? @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "simulacoes_cliente_fk")
}
