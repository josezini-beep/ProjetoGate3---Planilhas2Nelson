{
	"compilerOptions": {
		"target": "ES6",
		"module": "commonjs",
		"strict": true,
		"noImplicitAny": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"esModuleInterop": true,
		"allowImportingTsExtensions": false, 
		"emitDeclarationOnly": false,
		"declaration":true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
